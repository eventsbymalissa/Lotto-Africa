// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DrawStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  TOKEN_PURCHASE
  TICKET_PURCHASE
  WINNINGS_CREDIT
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  role               UserRole           @default(PLAYER)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  idDocumentUrl      String?
  idDocumentType     String?
  tokenBalance       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tickets            Ticket[]
  transactions       Transaction[]
  winnings           Winner[]
  verificationNotes  VerificationNote[]

  @@index([email])
}

model VerificationNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  note      String
  adminId   String
  createdAt DateTime @default(now())
}

model Draw {
  id            String     @id @default(uuid())
  name          String
  drawDate      DateTime
  jackpotAmount BigInt
  ticketPrice   Int        // in tokens
  status        DrawStatus @default(SCHEDULED)
  winningNumbers Int[]
  bonusNumber   Int?
  drawSeed      String?    // cryptographic seed committed before draw
  drawHash      String?    // hash of seed + result for verification
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tickets       Ticket[]
  winners       Winner[]
}

model Ticket {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  drawId        String
  draw          Draw     @relation(fields: [drawId], references: [id])
  numbers       Int[]
  bonusNumber   Int?
  isQuickPick   Boolean  @default(false)
  tokenCost     Int
  isChecked     Boolean  @default(false)
  prizeTier     String?
  prizeAmount   BigInt?
  createdAt     DateTime @default(now())

  winner        Winner?

  @@index([userId])
  @@index([drawId])
}

model Winner {
  id            String   @id @default(uuid())
  drawId        String
  draw          Draw     @relation(fields: [drawId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  ticketId      String   @unique
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
  prizeTier     String
  prizeAmount   BigInt
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?  // admin user id
  claimDeadline DateTime
  claimedAt     DateTime?
  verificationProof String? // JSON proof of win verification
  createdAt     DateTime @default(now())
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      BigInt            // in cents for money, or token count
  tokenAmount Int?              // tokens bought or spent
  description String
  reference   String?           // payment reference / ticket id
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([createdAt])
}

model TokenPackage {
  id          String   @id @default(uuid())
  name        String
  tokens      Int
  priceUsd    Int      // in cents
  bonusTokens Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
